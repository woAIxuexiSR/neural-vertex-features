{
    "scene": "scenes/living-room/dynamic_scene.xml",
    "animation": "scenes/living-room/animation.json",
    "v": [0.7, 0.4, 0.6, 0.7, 0.2],
    "cam_v": 0.0,
    "output": "living-room-dynamic",
    "train": {
        "use_subdivide": true,
        "use_adaptive_rhs": true,
        "loss": "weighted_normed_semi_l2",
        "rhs_samples": 32,
        "batch_size": 16384,
        "steps": 200000,
        "learning_rate": 0.001,
        "save_interval": 20000,
        "model_name": "dynamic.pth"
    },
    "model": {
        "type": "DModel",
        "feature_dim": 8,

        "grid_type_2d": "HashGrid",
        "n_levels_2d": 4,
        "n_features_per_level_2d": 2,
        "base_resolution_2d": 32,
        "per_level_scale_2d": 2.0,

        "vvmlp_output_dims": 128,

        "n_hidden_layers": 4,
        "n_neurons": 256
    }
}
